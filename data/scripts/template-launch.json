    {
      "name": "platform-portal-mosaic",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mosaic"
      ],
      "port": 3000,
      "cwd": "GitLab/WORKSPACE/mosaic/platform-portal"
    },
    {
      "name": "platform-portal-stitches",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:stitches"
      ],
      "port": 3000,
      "cwd": "GitLab/WORKSPACE/mosaic/platform-portal"
