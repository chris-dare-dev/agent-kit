{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin-web-app",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3002"
      ],
      "port": 3002,
      "cwd": "GitLab/workspace/platform/source/admin-web-app",
      "env": {
        "BASE_DOMAIN": "auth.example.com",
        "ADMIN_DOMAIN": "admin.auth.example.com"
      }
    },
    {
      "name": "admin-web-app-livemesh",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3002"
      ],
      "port": 3002,
      "cwd": "GitLab/workspace/platform/source/admin-web-app",
      "env": {
        "BASE_DOMAIN": "auth.example.com",
        "ADMIN_DOMAIN": "admin.auth.example.com",
        "TENANT": "operations",
        "THANOS_QUERY_URL": "http://localhost:19090",
        "LOKI_BASE_URL": "http://localhost:13100",
        "PLATFORM_CLUSTERS": "operations,core-services,observability,tenant-demo,tenant-example"
      }
    },
    {
      "name": "landing-page-web-app",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "cwd": "GitLab/workspace/platform/source/landing-page-web-app"
    },
    {
      "name": "mosaic-web-app",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dev.js",
        "tenant-example"
      ],
      "port": 3001,
      "cwd": "GitLab/workspace/platform/source/mosaic-web-app",
      "env": {
        "PORT": "3001",
        "SERVICE_REGISTRY_API_URL": "http://localhost:18099"
      }
    },
    {
      "name": "mosaic-web-app-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dev.js",
        "tenant-demo"
      ],
      "port": 3000,
      "cwd": "GitLab/workspace/platform/source/mosaic-web-app"
    },
    {
      "name": "mosaic-web-app-operations",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dev.js",
        "operations"
      ],
      "port": 3000,
      "cwd": "GitLab/workspace/platform/source/mosaic-web-app"
    },
    {
      "name": "platform-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
