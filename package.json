{
  "name": "@chris-dare-dev/agent-kit",
  "version": "0.1.0",
  "description": "Personal provider-neutral agent kit + artifact-memory substrate (fork of the kit architecture)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chris-dare-dev/agent-kit.git"
  },
  "homepage": "https://github.com/chris-dare-dev/agent-kit#readme",
  "bugs": {
    "url": "https://github.com/chris-dare-dev/agent-kit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-kit": "scripts/cli.mjs"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:update-golden": "node scripts/update-golden.mjs",
    "verify:quickstart": "node scripts/verify-quickstart.mjs",
    "init": "node scripts/init.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:init": "node --test tests/init.test.mjs",
    "test:uninstall": "node --test tests/uninstall.test.mjs",
    "test:unit": "npm test && npm run test:init && npm run test:uninstall",
    "gates": "node scripts/run-gates.mjs",
    "test:gates": "npm run gates",
    "test:substrate": "python3 workspace-tooling/run-substrate-tests.py",
    "wsl:smoke": "node scripts/wsl-smoke.mjs",
    "test:all": "npm run test:unit && npm run test:gates && npm run verify:quickstart"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/client-secrets-manager": "^3.750.0",
    "@aws-sdk/credential-provider-ini": "^3.750.0",
    "@aws-sdk/types": "^3.750.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "glob": "^11.0.2",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}