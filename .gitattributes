# Line endings and executability, pinned.
#
# The repo had no .gitattributes and its single commit was made under
# core.filemode=false (the Git-for-Windows default), so no tracked file carried
# the executable bit and a contributor with core.autocrlf=true checked out CRLF
# shell scripts that fail on POSIX with `bad interpreter: /usr/bin/env bash^M`.
# The owner's own clone is core.autocrlf=input, which is exactly why this was
# invisible from here.

* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.plist text eol=lf

# .jsonl is digest-sealed, not merely line-ending-sensitive: sealed-eval.py
# hashes the corpus bytes and compares against the sha256 recorded in the
# manifest. `text eol=lf` would still round-trip those bytes through git's
# normalisation filter, so a stray CR inside a record would be silently eaten
# on commit and the seal would verify against content the tree never held.
# `-text` disables conversion entirely: what is committed is what was hashed.
*.jsonl -text

# PowerShell is the one thing that genuinely wants CRLF.
*.ps1   text eol=crlf

*.png binary
*.gz  binary
