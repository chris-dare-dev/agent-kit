node_modules/
dist/
# Default --apply target of data/scripts/generate-adapter-packs.py. Rendered
# output, reproducible from the catalog; reviewable locally, never committed.
build/
__pycache__/
*.pyc
.DS_Store
npm-debug.log*

# Runtime logs written under the DEFAULT personal profile. The token log stores a
# 120-character raw preview of every tool call's arguments (summarizeArgs), and the
# cache snapshot stores raw argsKeys -- neither belongs in a public repository.
# Only SERVER_PROFILE=shared switches the log to hashed arguments.
.claude/mcp-token-log*.jsonl
.claude/mcp-cache-snapshot*.jsonl

# A personal project manifest stays local; the tracked example is
# project-map.example.json, which the consumers fall back to (issue #38).
workspace-tooling/project-map.json
